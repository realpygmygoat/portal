# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your deployed URL, used in email links and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (resend.com) for sending reminder emails
RESEND_API_KEY=
REMINDER_FROM_EMAIL=reminders@yourdomain.com

# Random secret string; protects /api/cron/reminders from public calls
CRON_SECRET=
